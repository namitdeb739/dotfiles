[user]
	name = Namit Deb
	email = namitdeb739@gmail.com

[core]
	editor = code --wait
	pager = delta
	excludesfile = ~/.gitignore_global
	autocrlf = input

[gpg]
	format = ssh

[gpg "ssh"]
	# Lets `git log --show-signature` verify locally; GitHub verifies via the
	# signing key uploaded to the account, independently of this file.
	allowedSignersFile = ~/.config/git/allowed_signers

[user]
	# Sign with the SSH key bootstrap.sh generates.
	signingkey = ~/.ssh/id_ed25519.pub

# Signing is configured but off by default. Nothing enforces it: no repo sets
# required_signatures, and at this scale essentially nobody signs locally —
# sampling 30 commits each from tikuOS, eza, just, uv and simonw/llm, every
# "Verified" badge came from GitHub's own key on a web merge, not a maintainer.
# Signing also cost real friction: SSH signing needs the ssh-agent socket, which
# the Bash sandbox denies, so `git commit` had to be exempted from the sandbox
# entirely — taking every pre-commit hook outside it too.
# To sign a specific repo anyway: `git config --local commit.gpgsign true`.
[commit]
	gpgsign = false

[tag]
	gpgsign = false

[init]
	defaultBranch = main

[push]
	default = current
	autoSetupRemote = true

[pull]
	rebase = true

[fetch]
	prune = true

[merge]
	conflictstyle = diff3

[diff]
	colorMoved = default

[rebase]
	autoStash = true

[alias]
	# Shorthands with no shell alias equivalent
	cm = commit -m
	ca = commit --amend
	cp = cherry-pick
	ll = log --pretty=format:'%C(yellow)%h%Creset %s %C(green)(%cr)%Creset %C(blue)<%an>%Creset' -20
	undo = reset --soft HEAD~1
	unstage = restore --staged
	wip = !git add -A && git commit -m 'chore: wip'
	cleanup = !git branch --merged main | grep -v 'main' | xargs -r git branch -d

# Homebrew's /opt/homebrew/etc/gitconfig sets credential.helper = osxkeychain
# for every host. Inside Claude Code's sandbox all traffic goes through a
# localhost HTTP proxy whose URL carries ephemeral credentials, so after each
# successful transfer git tries to persist those into the keychain — a write the
# sandbox denies, printing `fatal: failed to store: 100001` on every fetch/push.
# Reset that list and re-add osxkeychain behind a guard that drops the proxy's
# throwaway credentials instead of storing them.
[credential]
	helper =
	helper = "!f() { data=$(cat); case \"$data\" in *host=localhost:*) exit 0;; esac; printf '%s\\n' \"$data\" | git credential-osxkeychain \"$1\"; }; f"

[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
