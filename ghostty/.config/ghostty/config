# ============================================================
# Dotfiles-managed Ghostty config — Catppuccin Latte / Mocha
# ============================================================
# Ghostty 1.3.1 (macOS, Metal renderer, CoreText font engine).
#
# NOTE: Ghostty does NOT support trailing comments. A '#' must start
# its own line, or it becomes part of the value.
#
# Full option reference for the exact installed binary:
#   ghostty +show-config --default --docs
# Validate this file after editing:
#   ghostty +validate-config
# Reload without restarting: cmd+shift+, (bound below, applies to all surfaces)

# --- Theme ---
# Byte-identical to iterm2/colors/catppuccin-{latte,mocha}.itermcolors, so the
# ANSI palette, background, foreground, cursor and selection colours are the
# same ones iTerm2 renders. Verified against Ghostty's bundled theme files.
# Ghostty follows the macOS appearance setting, so `theme-toggle` (bin/) flips
# this automatically alongside VS Code's window.autoDetectColorScheme.
theme = light:Catppuccin Latte,dark:Catppuccin Mocha
# Titlebar and window chrome follow the same light/dark switch.
window-theme = auto

# --- Font ---
# Exact family name as CoreText sees it — confirmed with `ghostty +list-fonts`.
# Installed by brew/Brewfile: cask "font-jetbrains-mono-nerd-font".
# The Nerd Font glyphs are what render starship's powerline separators and the
# language/OS symbols in starship.toml.
font-family = JetBrainsMono Nerd Font Mono
font-size = 14
# Slightly looser line height; percentage scales with font-size.
adjust-cell-height = 8%
# Keep JetBrains Mono's ligatures, but break the shaping run at the cursor so
# individual characters stay visible while editing in nvim.
font-shaping-break = cursor

# --- Window / appearance ---
# Native macOS tabs rendered into the titlebar — closest match to the iTerm2
# tab bar. Incompatible with macos-non-native-fullscreen, hence that stays off.
macos-titlebar-style = tabs
macos-non-native-fullscreen = false
# Breathing room; `balance` stops leftover pixels piling onto one edge.
window-padding-x = 12
window-padding-y = 10
window-padding-balance = true
# Padding takes the theme background rather than smearing the nearest cell.
window-padding-color = background
# Dim inactive splits enough to see focus without hurting legibility.
unfocused-split-opacity = 0.85
# Don't restore stale window layouts on launch.
window-save-state = never

# --- Colour fidelity ---
# Mirrors "terminal.integrated.minimumContrastRatio": 1 in vscode/settings.json:
# render Catppuccin's colours exactly as authored, no automatic contrast bump.
minimum-contrast = 1

# --- Cursor ---
# Mirrors "terminal.integrated.cursorBlinking": true in vscode/settings.json.
cursor-style = block
cursor-style-blink = true
# Option-click to move the zsh cursor. Requires shell integration (below).
cursor-click-to-move = true
mouse-hide-while-typing = true

# --- Shell integration (zsh + starship + atuin) ---
# Auto-detects zsh and injects via ZDOTDIR, so .zshrc needs no changes.
# Gives OSC 133 prompt marking -> jump_to_prompt, cwd inheritance for new
# tabs/splits, and no close-confirmation at an idle prompt.
shell-integration = detect
# cursor  — shell-driven cursor shape changes
# title   — sets the tab/window title from the running command
# sudo    — keeps xterm-ghostty terminfo across `sudo nvim` etc.
# ssh-env / ssh-terminfo — installs Ghostty's terminfo on remote hosts so TUIs
#           render correctly instead of falling back to xterm-256color
shell-integration-features = cursor,title,sudo,ssh-env,ssh-terminfo

# --- Behaviour ---
# Scrollback is measured in BYTES, not lines. 100MB is far more than VS Code's
# 10000-line terminal buffer; search it in place with cmd+f.
scrollback-limit = 100000000
# Mirrors "terminal.integrated.copyOnSelection": true. Plain `true` would use
# the near-useless macOS selection clipboard; `clipboard` puts it where cmd+V
# will find it, matching iTerm2 behaviour.
copy-on-select = clipboard
# Confirm before pasting anything containing control characters or newlines.
clipboard-paste-protection = true
# nvim uses clipboard=unnamedplus, so let programs write the clipboard via
# OSC 52 (yank over ssh works), but require a prompt before reading it back.
clipboard-write = allow
clipboard-read = ask
# Don't let programs read the window title back out — escape-sequence exfil.
title-report = false
# Stay alive in the Dock after the last window closes, for the quick terminal.
quit-after-last-window-closed = false
# Desktop notification when a long command finishes in an unfocused surface.
# Complements starship's cmd_duration.show_notifications (min_time 45s).
notify-on-command-finish = unfocused
notify-on-command-finish-after = 45s

# --- macOS keyboard ---
# Both Option keys send Alt / ESC-prefix so nvim and readline meta-bindings
# work. Use `left` or `right` instead if you need to type accented characters.
macos-option-as-alt = true

# --- Quick terminal (Quake-style dropdown) ---
# No default binding exists. `global:` requires Accessibility permission in
# System Settings > Privacy & Security > Accessibility.
keybind = global:cmd+grave_accent=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-screen = mouse
quick-terminal-autohide = true
quick-terminal-space-behavior = move
quick-terminal-animation-duration = 0.15

# --- Keybinds ---
# Defaults already match this setup: cmd+d splits right and cmd+shift+d splits
# down, mirroring nvim's splitright/splitbelow. cmd+shift+p opens the command
# palette, cmd+f searches scrollback.
# See everything you'd be overriding: `ghostty +list-keybinds --default`
#
# Reload this file on every surface, not just the focused one.
keybind = all:cmd+shift+comma=reload_config
# Prompt-to-prompt navigation (requires shell integration, above).
keybind = cmd+up=jump_to_prompt:-1
keybind = cmd+down=jump_to_prompt:1
# Even out splits after resizing — no default binding for this.
keybind = cmd+ctrl+equal=equalize_splits
# Dump the whole scrollback into $EDITOR for real editing.
keybind = cmd+shift+f=write_scrollback_file:open
# Terminal inspector: live escape-sequence and render debugging.
keybind = cmd+alt+i=inspector:toggle
# Rename the current split/tab from a prompt.
keybind = cmd+shift+r=prompt_surface_title

# --- Machine-local overrides ---
# Gitignored, optional (the '?' means "skip silently if absent"). Use it for
# per-machine tweaks like font-size on an external display.
# NOTE: config-file includes are processed at END of file, so keys written
# after this line do NOT override local.conf.
config-file = ?local.conf
