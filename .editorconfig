# Baseline formatting for editors that read EditorConfig.
# Complements ruff and Prettier, which do not cover Lua, shell or plists.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py,pyi}]
indent_size = 4

[*.{sh,bash,zsh}]
indent_size = 2

[*.lua]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.plist]
indent_size = 4
