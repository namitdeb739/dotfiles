{
  "general": {
    "launcherShortcut": "cmd+space",
    "showInMenuBar": false,
    "automaticallyCheckForUpdates": true,
    "popToRootSeconds": 0,
    "escapeKeyBehavior": "navigateBackOrClose",
    "autoSwitchInputSource": null,
    "supportReminders": true,
    "language": "en"
  },
  "appearance": {
    "theme": "system",
    "interfaceSize": "standard",
    "compactMode": true,
    "showFavoritesInCompactMode": true,
    "followCursorAcrossDisplays": true,
    "dragToReposition": true
  },
  "hyperKey": {
    "key": "none",
    "includesShift": true,
    "quickPress": "none",
    "secureInputCompatibility": false
  },
  "calculator": {
    "numberStyle": "system"
  },
  "search": {
    "showsSuggestions": true,
    "sensitivity": "medium"
  },
  "applications": {
    "enabled": true,
    "searchScopes": [
      "/Applications",
      "/Applications/Utilities",
      "/System/Applications",
      "/System/Applications/Utilities",
      "/System/Library/CoreServices/Applications",
      "/System/Volumes/Preboot/Cryptexes/App/System/Applications",
      "/System/Library/CoreServices/Finder.app",
      "~/Applications"
    ],
    "apps": {
      "com.mitchellh.ghostty": {
        "shortcut": "ctrl+option+t"
      },
      "md.obsidian": {
        "shortcut": "ctrl+option+o"
      },
      "com.apple.Safari": {
        "shortcut": "ctrl+option+b"
      },
      "com.microsoft.VSCode": {
        "shortcut": "ctrl+option+c"
      },
      "notion.id": {
        "shortcut": "ctrl+option+n"
      },
      "net.whatsapp.WhatsApp": {
        "shortcut": "ctrl+option+w"
      },
      "com.tdesktop.Telegram": {
        "shortcut": "ctrl+option+g"
      },
      "net.ankiweb.anki": {
        "shortcut": "ctrl+option+a"
      },
      "com.apple.finder": {
        "shortcut": "ctrl+option+f"
      }
    }
  },
  "systemSettings": {
    "enabled": true,
    "panes": {}
  },
  "systemActions": {
    "enabled": true,
    "actions": {}
  },
  "commands": {
    "builtInEnabled": true,
    "builtIn": {},
    "enabled": true,
    "showInLauncher": true
  },
  "quicklinks": {
    "enabled": true,
    "showInLauncher": true,
    "opensNewWindow": false,
    "passesSelectedText": false,
    "confirmsBeforeDelete": true,
    "commands": {}
  },
  "appleShortcuts": {
    "enabled": true
  },
  "ai": {
    "enabled": true,
    "webSearch": true,
    "choices": true,
    "systemPrompt": "",
    "systemPromptEnabled": true,
    "retentionDays": "forever",
    "opensTo": "recent",
    "newChatAfterMinutes": 5,
    "toolRounds": 25,
    "commands": {}
  },
  "quickActions": {
    "targetLanguage": "",
    "commands": {}
  },
  "dictation": {
    "mode": "toggle",
    "shortcut": null,
    "model": "redux",
    "microphone": null,
    "destination": "paste",
    "adaptsCapitalization": true,
    "liveInsertion": false,
    "releaseAfterMinutes": 1,
    "language": null
  },
  "fileSearch": {
    "enabled": true,
    "scopes": [
      "~"
    ],
    "ignorePatterns": [
      "*.log",
      "*.tmp",
      ".DS_Store",
      "~/Downloads"
    ],
    "removedDefaultPatterns": [],
    "showInLauncher": true,
    "commands": {}
  },
  "notes": {
    "enabled": true,
    "rendersMarkdown": true,
    "showsFormattingBar": true,
    "folder": null,
    "commands": {}
  },
  "snippets": {
    "showInLauncher": true,
    "folder": "~/.config/tinycast/snippets",
    "commands": {
      "search-snippets": {
        "shortcut": "ctrl+option+s"
      }
    }
  },
  "navigation": {
    "enabled": true,
    "menuSearchShowsAppleMenu": false,
    "menuSearchDisabledApps": [],
    "commands": {}
  },
  "windowManagement": {
    "enabled": false,
    "showInLauncher": true,
    "gap": 0,
    "cycle": "off",
    "layoutsShowInLauncher": true,
    "roomsShowInLauncher": true,
    "shortcuts": {
      "left-half": null,
      "right-half": null,
      "top-half": null,
      "bottom-half": null,
      "top-left-quarter": null,
      "top-right-quarter": null,
      "bottom-left-quarter": null,
      "bottom-right-quarter": null,
      "first-three-fourths": null,
      "last-three-fourths": null,
      "first-third": null,
      "center-third": null,
      "last-third": null,
      "first-two-thirds": null,
      "last-two-thirds": null,
      "maximize": null,
      "almost-maximize": null,
      "reasonable-size": null,
      "maximize-height": null,
      "maximize-width": null,
      "center": null,
      "center-half": null,
      "center-two-thirds": null,
      "make-larger": null,
      "make-smaller": null,
      "restore": null,
      "move-left": null,
      "move-right": null,
      "move-up": null,
      "move-down": null,
      "next-display": null,
      "previous-display": null,
      "toggle-fullscreen": null,
      "previous-space": null,
      "next-space": null
    },
    "aliases": {},
    "customSizes": [],
    "layouts": [],
    "rooms": [],
    "commands": {}
  },
  "clipboard": {
    "enabled": true,
    "retentionDays": "forever",
    "defaultAction": "paste",
    "disabledApps": [
      "com.apple.keychainaccess",
      "com.apple.Passwords"
    ],
    "commands": {
      "clipboard-history": {
        "shortcut": "cmd+shift+v"
      }
    }
  },
  "emoji": {
    "skinTone": "medium",
    "gridColumns": 8,
    "commands": {}
  },
  "calendar": {
    "showInLauncher": true,
    "launcherLimit": 5,
    "span": "todayAndTomorrow",
    "joinWindowMinutes": 5,
    "autoJoinConfirms": true,
    "autoJoinNamedProvidersOnly": false,
    "meetingBrowser": null,
    "menuBar": "disabled",
    "menuBarUpcomingEvents": "today",
    "menuBarLinkedEventsOnly": true,
    "menuBarHidesWhenEmpty": false,
    "hideCurrentEventAfterMinutes": "never",
    "commands": {
      "join-next-meeting": {
        "shortcut": "ctrl+option+j"
      }
    }
  },
  "extensions": {
    "showInLauncher": true
  }
}
