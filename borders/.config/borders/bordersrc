#!/usr/bin/env bash
#
# JankyBorders — draws a border around the focused window.
#
# Independent of the window manager: it only reads which window has focus, so
# it works alongside Loop exactly as it would with yabai or AeroSpace.
#
# Colours are Catppuccin, matching ghostty, nvim, tmux and the VS Code theme.
# macOS cannot tell a running process the system appearance cheaply, so the
# palette is fixed to Mocha, the same trade-off tmux and lazygit already make.
#
# Applied at login by `brew services start borders`; reload after editing with
# `brew services restart borders`.

options=(
  # Catppuccin Mocha blue for the active window, matching ghostty's cursor and
  # tmux's active pane border. 0xAARRGGBB.
  active_color=0xff89b4fa
  # Surface0 — visible enough to read as a border, quiet enough to recede.
  inactive_color=0xff313244
  width=5.0
  # Follow the window's own corner radius rather than drawing square corners
  # over rounded ones.
  style=round
  # Render at native resolution on Retina; without this the border is drawn at
  # 1x and looks soft against everything else on the screen.
  hidpi=on
  # Track the accessibility API's focused window rather than the frontmost
  # application. Loop moves windows without changing the front app, so without
  # this the border can lag behind what is actually focused.
  ax_focus=on
)

borders "${options[@]}"
