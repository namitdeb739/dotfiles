#!/usr/bin/env bash
# secret — manage shell secrets in the macOS login Keychain.
#
# Secrets live in the Keychain rather than a plaintext ~/.secrets file, so they
# are encrypted at rest and backed up by iCloud Keychain sync. ~/.zsh/secrets.zsh
# exports them into each interactive shell.
#
# Usage:
#   secret set   NAME [VALUE]   # VALUE omitted -> prompt without echoing
#   secret get   NAME
#   secret list                 # names only, never values
#   secret rm    NAME
#   secret import [FILE]        # migrate an existing ~/.secrets, then shred it
#   secret export               # print `export NAME=...` lines (for eval)

set -Eeuo pipefail

SERVICE_PREFIX="dotfiles:"
ACCOUNT="${USER}"

die() { echo "secret: $*" >&2; exit 1; }

# Keychain stores one generic-password item per secret, tagged with a prefix so
# `list` can find them without walking unrelated Keychain entries.
_service() { printf '%s%s' "$SERVICE_PREFIX" "$1"; }

cmd_set() {
  local name="${1:-}" value="${2:-}"
  [[ -n "$name" ]] || die "usage: secret set NAME [VALUE]"

  if [[ -z "$value" ]]; then
    read -r -s -p "Value for $name: " value
    echo
    [[ -n "$value" ]] || die "empty value; nothing stored"
  fi

  # -U updates in place if the item already exists.
  security add-generic-password -U -a "$ACCOUNT" -s "$(_service "$name")" \
    -D "dotfiles secret" -w "$value"
  echo "Stored: $name"
}

cmd_get() {
  local name="${1:-}"
  [[ -n "$name" ]] || die "usage: secret get NAME"
  security find-generic-password -a "$ACCOUNT" -s "$(_service "$name")" -w 2>/dev/null \
    || die "not found: $name"
}

cmd_list() {
  # dump-keychain would prompt repeatedly; instead read the item metadata.
  security dump-keychain 2>/dev/null \
    | grep -o "\"svce\"<blob>=\"${SERVICE_PREFIX}[^\"]*\"" \
    | sed "s/.*\"${SERVICE_PREFIX}//; s/\"$//" \
    | sort -u
}

cmd_rm() {
  local name="${1:-}"
  [[ -n "$name" ]] || die "usage: secret rm NAME"
  security delete-generic-password -a "$ACCOUNT" -s "$(_service "$name")" >/dev/null 2>&1 \
    || die "not found: $name"
  echo "Removed: $name"
}

cmd_export() {
  local name value
  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    value="$(security find-generic-password -a "$ACCOUNT" -s "$(_service "$name")" -w 2>/dev/null)" || continue
    printf 'export %s=%q\n' "$name" "$value"
  done < <(cmd_list)
}

cmd_import() {
  local file="${1:-$HOME/.secrets}"
  [[ -f "$file" ]] || die "no such file: $file"

  local count=0 name value line
  while IFS= read -r line; do
    [[ "$line" =~ ^[[:space:]]*# ]] && continue
    [[ "$line" =~ ^[[:space:]]*export[[:space:]]+([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]] || continue
    name="${BASH_REMATCH[1]}"
    value="${BASH_REMATCH[2]}"
    # Strip one layer of surrounding quotes.
    value="${value%\"}"; value="${value#\"}"
    value="${value%\'}"; value="${value#\'}"
    [[ -n "$value" ]] || continue
    security add-generic-password -U -a "$ACCOUNT" -s "$(_service "$name")" \
      -D "dotfiles secret" -w "$value"
    echo "Imported: $name"
    count=$((count + 1))
  done < "$file"

  [[ "$count" -gt 0 ]] || die "no 'export NAME=value' lines found in $file"

  echo
  echo "$count secret(s) now in the Keychain."
  echo "Verify with 'secret list', then remove the plaintext file:"
  echo "  rm -P $file"
}

case "${1:-}" in
  set)    shift; cmd_set "$@" ;;
  get)    shift; cmd_get "$@" ;;
  list)   shift; cmd_list ;;
  rm)     shift; cmd_rm "$@" ;;
  export) shift; cmd_export ;;
  import) shift; cmd_import "$@" ;;
  -h|--help|"")
    sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  *) die "unknown command: $1 (try --help)" ;;
esac
