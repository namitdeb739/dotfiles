#!/usr/bin/env bash
# dotfiles-update — scheduled maintenance for the dotfiles-managed machine.
#
# Upgrades installed software and re-converges the machine onto the repo's
# declared state. It deliberately never touches git: no pull, no commit, no
# push. The repo is the source of truth and only changes when you change it.
#
# Run manually any time. Scheduled weekly by
# ~/Library/LaunchAgents/com.namitdeb739.dotfiles-update.plist
#
# Usage: dotfiles-update [--dry-run] [--quiet]

set -Eeuo pipefail

REPO_DIR="${DOTFILES_DIR:-$HOME/Developer/dotfiles}"
STATE_DIR="$HOME/.local/state/dotfiles-update"
LOG_FILE="$STATE_DIR/update.log"
SUMMARY_FILE="$STATE_DIR/last-summary"
LOG_KEEP=8

DRY_RUN=0
QUIET=0

for arg in "$@"; do
  case "$arg" in
    --dry-run) DRY_RUN=1 ;;
    --quiet)   QUIET=1 ;;
    -h|--help)
      sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *)
      echo "Unknown option: $arg" >&2
      exit 1
      ;;
  esac
done

mkdir -p "$STATE_DIR"

# --- Logging ---------------------------------------------------------------

log() {
  printf '%s  %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"
}

section() {
  log ""
  log "=== $* ==="
}

# Rotate before writing so the current run is always the newest file.
rotate_logs() {
  [[ -f "$LOG_FILE" ]] || return 0
  mv "$LOG_FILE" "$LOG_FILE.$(date -r "$LOG_FILE" '+%Y%m%d-%H%M%S')"
  # Keep only the newest $LOG_KEEP archives.
  local old
  # shellcheck disable=SC2012
  old="$(ls -1t "$LOG_FILE".* 2>/dev/null | tail -n "+$((LOG_KEEP + 1))" || true)"
  [[ -n "$old" ]] && printf '%s\n' "$old" | while IFS= read -r f; do rm -f "$f"; done
  return 0
}

run() {
  if [[ "$DRY_RUN" -eq 1 ]]; then
    log "[dry-run] $*"
    return 0
  fi
  "$@"
}

# --- Failure reporting -----------------------------------------------------

FAILED_STEP=""

# Set when `brew bundle` reports failures. Not fatal: see brew_maintenance().
BUNDLE_FAILED=0

# Casks whose installers are .pkg files, so Homebrew shells out to
# `sudo installer`. A launchd job has no terminal and no way to answer a
# password prompt, so these can never install unattended — the run would fail
# at the same point every week, and every step after it would never run.
#
# They stay declared in brew/Brewfile: a fresh interactive bootstrap still
# installs them, and the drift check still accounts for them. Only the
# unattended path skips them.
#
# Detected from cask metadata rather than hardcoded. A hand-maintained list has
# exactly the drift problem stow-packages.txt exists to solve — the first
# version of this list was already missing karabiner-elements. One batched
# `brew info` call, about a second.
sudo_casks() {
  local casks
  casks=$(grep -oE '^cask "[^"]+"' "$REPO_DIR/brew/Brewfile" | sed 's/cask "//;s/"$//')
  [[ -z "$casks" ]] && return 0

  # shellcheck disable=SC2086
  brew info --cask --json=v2 $casks 2>/dev/null | python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)
tokens = [
    c["token"]
    for c in data.get("casks", [])
    if any(isinstance(a, dict) and "pkg" in a for a in c.get("artifacts", []))
]
print(" ".join(sorted(tokens)))
' || true
}

notify_failure() {
  local step="$1"
  [[ "$QUIET" -eq 1 ]] && return 0
  osascript -e "display notification \"Step: ${step}. See ${LOG_FILE}\" with title \"dotfiles-update failed\"" 2>/dev/null || true
}

on_error() {
  local rc=$?
  log "FAILED (exit $rc) during: ${FAILED_STEP:-unknown step}"
  printf 'dotfiles-update FAILED during: %s\nLog: %s\n' "${FAILED_STEP:-unknown}" "$LOG_FILE" > "$SUMMARY_FILE"
  notify_failure "${FAILED_STEP:-unknown}"
  exit "$rc"
}
trap on_error ERR

step() { FAILED_STEP="$1"; section "$1"; }

# --- Steps -----------------------------------------------------------------

UPGRADED_COUNT=0
OUTDATED_BEFORE=""
DRIFT_REPORT=""

brew_maintenance() {
  command -v brew >/dev/null || { log "Homebrew not installed; skipping"; return 0; }

  step "brew update"
  run brew update

  step "brew outdated"
  OUTDATED_BEFORE="$(brew outdated --quiet || true)"
  if [[ -n "$OUTDATED_BEFORE" ]]; then
    UPGRADED_COUNT="$(printf '%s\n' "$OUTDATED_BEFORE" | grep -c . || true)"
    log "$UPGRADED_COUNT package(s) outdated:"
    printf '%s\n' "$OUTDATED_BEFORE" | sed 's/^/    /'
  else
    log "Everything up to date."
  fi

  step "brew upgrade"
  # Casks that manage their own updates (Ghostty via Sparkle, VS Code, Raycast)
  # are upgraded too; --greedy is deliberately NOT used so self-updating apps
  # are left alone unless the Brewfile version genuinely moved.
  run brew upgrade

  step "brew bundle"
  # Re-converge on the Brewfile: installs anything declared but missing.
  #
  # Deliberately NOT fatal. A cask that cannot install must not cost us the
  # restow and integrity checks that follow — those are the whole point of the
  # weekly run. The failure is recorded and surfaced in the summary and the
  # exit code instead.
  local skip
  skip="$(sudo_casks)"

  if ! HOMEBREW_BUNDLE_CASK_SKIP="$skip" \
       run brew bundle --file="$REPO_DIR/brew/Brewfile" --no-upgrade; then
    BUNDLE_FAILED=1
    log "brew bundle reported failures; continuing so the later steps still run"
  fi
  if [[ -n "$skip" ]]; then
    log "skipped (.pkg installers need sudo; install by hand): $skip"
  fi

  step "brew cleanup"
  run brew cleanup --prune=30

  step "brew doctor"
  # Advisory only; brew doctor exits non-zero for harmless warnings.
  brew doctor 2>&1 | sed 's/^/    /' || log "(brew doctor reported warnings; not treated as failure)"
}

# Report packages installed by hand but never declared in the Brewfile, and
# declared packages that are no longer installed. Report only — this never
# uninstalls anything, so a deliberate one-off install is not destroyed by an
# unattended job. `brew bundle cleanup` is deliberately NOT used: it lists every
# transitive dependency too, which buries the handful of entries that matter.
brewfile_drift() {
  command -v brew >/dev/null || return 0

  step "Brewfile drift"

  local brewfile="$REPO_DIR/brew/Brewfile"
  [[ -f "$brewfile" ]] || { log "no Brewfile; skipping"; return 0; }

  local tmp; tmp="$(mktemp -d)"
  # shellcheck disable=SC2064
  trap "rm -rf '$tmp'" RETURN

  # Declared, as plain names.
  sed -n 's/^brew "\([^"]*\)".*/\1/p' "$brewfile" | sed 's|.*/||' | sort -u > "$tmp/declared-formulae"
  sed -n 's/^cask "\([^"]*\)".*/\1/p' "$brewfile" | sort -u > "$tmp/declared-casks"

  # Installed. `--installed-on-request` excludes packages pulled in only as
  # dependencies, which is what makes this signal readable.
  # `brew leaves` prints tap-qualified names for third-party formulae
  # (felixkratz/formulae/borders), while the declared list above strips the tap
  # prefix. Normalise both sides the same way or every tapped formula is
  # reported as simultaneously missing and unexpected.
  brew leaves --installed-on-request | sed 's|.*/||' | sort -u > "$tmp/installed-formulae"
  brew list --cask 2>/dev/null | sort -u > "$tmp/installed-casks"

  local undeclared_f undeclared_c missing_f missing_c
  undeclared_f="$(comm -23 "$tmp/installed-formulae" "$tmp/declared-formulae")"
  undeclared_c="$(comm -23 "$tmp/installed-casks" "$tmp/declared-casks")"
  missing_f="$(comm -13 "$tmp/installed-formulae" "$tmp/declared-formulae")"
  missing_c="$(comm -13 "$tmp/installed-casks" "$tmp/declared-casks")"

  DRIFT_REPORT=""

  _drift_block() {
    local title="$1" body="$2"
    [[ -z "$body" ]] && return 0
    log "$title"
    printf '%s\n' "$body" | sed 's/^/    /'
    DRIFT_REPORT+="$title"$'\n'
    DRIFT_REPORT+="$(printf '%s\n' "$body" | sed 's/^/  · /')"$'\n'
  }

  # Apps installed by hand land in /Applications and never appear in
  # `brew list --cask`, so a brew-only comparison reports "no drift" while the
  # machine is unreproducible. Map each declared cask to the .app it ships and
  # report anything in /Applications that no cask accounts for.
  local unmanaged_apps=""
  if [[ -d /Applications ]]; then
    unmanaged_apps="$(
      python3 - "$brewfile" "$REPO_DIR/brew/drift-ignore" <<'PYEOF'
import json, pathlib, re, subprocess, sys

brewfile = pathlib.Path(sys.argv[1]).read_text()
declared = re.findall(r'^cask "([^"]+)"', brewfile, re.M)

# Explicit opt-outs: apps with no cask that are expected to be here.
ignore = set()
ignore_file = pathlib.Path(sys.argv[2])
if ignore_file.exists():
    for line in ignore_file.read_text().splitlines():
        name = line.split("#", 1)[0].strip()
        if name:
            ignore.add(name)

# Apple ships these; they are not installable and not drift.
STOCK = {
    "Safari", "Mail", "Messages", "FaceTime", "Photos", "Music", "TV",
    "Podcasts", "News", "Stocks", "Home", "Maps", "Notes", "Reminders",
    "Calendar", "Contacts", "Freeform", "Preview", "Numbers", "Pages",
    "Keynote", "GarageBand", "iMovie", "App Store", "System Settings",
    "Utilities", "Books", "Shortcuts", "Weather", "Clock", "Calculator",
    "Dictionary", "Font Book", "Image Capture", "Mission Control",
    "Photo Booth", "QuickTime Player", "Screenshot", "Siri", "TextEdit",
    "Time Machine", "VoiceMemos", "Voice Memos", "Automator", "Chess",
    "Launchpad", "Passwords", "Journal", "Tips", "Find My", "iPhone Mirroring",
}

owned = set()
pkg_tokens = set()
if declared:
    out = subprocess.run(
        ["brew", "info", "--cask", "--json=v2", *declared],
        capture_output=True, text=True,
    )
    if out.returncode == 0:
        try:
            for cask in json.loads(out.stdout).get("casks", []):
                for art in cask.get("artifacts", []):
                    if not isinstance(art, dict):
                        continue
                    for name in art.get("app", []) or []:
                        if isinstance(name, str) and name.endswith(".app"):
                            owned.add(name[:-4])
                    # pkg casks ship no .app name at all; remember the token
                    # so the vendor-prefix fallback below can match the apps
                    # the installer drops (e.g. microsoft-office -> Word).
                    if "pkg" in art or "installer" in art:
                        pkg_tokens.add(cask.get("token", ""))
        except json.JSONDecodeError:
            pass

apps_dir = pathlib.Path("/Applications")
for app in sorted(p.name[:-4] for p in apps_dir.glob("*.app")):
    if app in STOCK or app in owned or app in ignore or app.startswith("."):
        continue
    # Mac App Store apps carry a receipt and cannot be installed by Homebrew,
    # so they are never actionable drift.
    if (apps_dir / f"{app}.app" / "Contents" / "_MASReceipt" / "receipt").exists():
        continue
    slug = app.lower().replace(" ", "-")
    if any(slug.startswith(o.lower()) or o.lower().startswith(slug) for o in owned if o):
        continue
    # A pkg cask installs several differently-named apps; credit it with any
    # app sharing its leading vendor word (microsoft-office -> Microsoft Word).
    vendors = {t.split("-")[0] for t in pkg_tokens if t}
    if slug.split("-")[0] in vendors:
        continue
    print(app)
PYEOF
    )"
  fi

  _drift_block "Installed but not in the Brewfile (formulae):" "$undeclared_f"
  _drift_block "Installed but not in the Brewfile (casks):" "$undeclared_c"
  _drift_block "Apps in /Applications not accounted for by any declared cask:" "$unmanaged_apps"
  _drift_block "In the Brewfile but not installed (formulae):" "$missing_f"
  _drift_block "In the Brewfile but not installed (casks):" "$missing_c"

  if [[ -z "$DRIFT_REPORT" ]]; then
    log "No drift: installed packages match the Brewfile."
  else
    log "Add what you want to keep to brew/Brewfile, or uninstall it by hand."
  fi

  return 0
}

zsh_plugins() {
  local antidote_path
  antidote_path="$(brew --prefix 2>/dev/null)/opt/antidote/share/antidote/antidote.zsh"
  [[ -f "$antidote_path" && -f "$HOME/.zsh_plugins.txt" ]] || {
    log "antidote or ~/.zsh_plugins.txt missing; skipping"
    return 0
  }

  step "antidote plugin update"
  run zsh -c "source '$antidote_path' && antidote update" || log "(antidote update reported an issue; continuing)"

  step "regenerate static plugin file"
  # Mirrors init_zsh_plugins() in bootstrap.sh.
  run zsh -c "source '$antidote_path' && antidote bundle < ~/.zsh_plugins.txt > ~/.zsh_plugins.zsh"
}

restow_packages() {
  command -v stow >/dev/null || { log "stow not installed; skipping"; return 0; }

  step "restow packages"
  # Package list comes from stow-packages.txt, the same file bootstrap.sh
  # reads. These were previously two hardcoded lists that drifted: the weekly
  # restow had silently stopped repairing act, gh, karabiner, lazygit, ssh
  # and tmux. Restowing is idempotent and repairs symlinks broken by an app
  # rewriting its own config.
  local manifest="$REPO_DIR/stow-packages.txt"
  [[ -f "$manifest" ]] || { log "stow-packages.txt missing; skipping"; return 0; }

  local pkg
  while IFS= read -r pkg; do
    [[ -z "$pkg" || "$pkg" == \#* ]] && continue
    [[ -d "$REPO_DIR/$pkg" ]] || continue
    run stow --dir="$REPO_DIR" --target="$HOME" --restow --no-folding "$pkg"
    log "restowed: $pkg"
  done < "$manifest"
}

verify() {
  step "stow integrity check"
  run bash "$REPO_DIR/check-stow-integrity.sh"

  if command -v ghostty >/dev/null; then
    step "ghostty config validation"
    run ghostty +validate-config
    log "ghostty config OK"
  fi
}

write_summary() {
  {
    printf 'dotfiles-update — %s\n' "$(date '+%a %d %b %Y, %H:%M')"
    if [[ "$BUNDLE_FAILED" -eq 1 ]]; then
      printf 'brew bundle had failures; later steps still ran.\n'
    fi
    if [[ "$UPGRADED_COUNT" -gt 0 ]]; then
      printf '%s package(s) upgraded:\n' "$UPGRADED_COUNT"
      printf '%s\n' "$OUTDATED_BEFORE" | sed 's/^/  · /'
    else
      printf 'No upgrades needed.\n'
    fi
    if [[ -n "$DRIFT_REPORT" ]]; then
      printf '%s' "$DRIFT_REPORT"
    fi
    printf 'Log: %s\n' "$LOG_FILE"
  } > "$SUMMARY_FILE"
}

# --- Main ------------------------------------------------------------------

main() {
  rotate_logs
  exec > >(tee -a "$LOG_FILE") 2>&1

  log "dotfiles-update starting (repo: $REPO_DIR)"
  [[ "$DRY_RUN" -eq 1 ]] && log "DRY RUN — no changes will be made"

  brew_maintenance
  brewfile_drift
  zsh_plugins
  restow_packages
  verify

  FAILED_STEP=""
  write_summary

  section "done"
  if [[ "$BUNDLE_FAILED" -eq 1 ]]; then
    log "Completed, but brew bundle reported failures — see above."
    log "Everything after it (drift, restow, integrity, ghostty) still ran."
    exit 1
  fi
  log "Completed successfully."
}

main "$@"
