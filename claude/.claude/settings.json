{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ENABLE_TOOL_SEARCH": "auto:5",
    "BASH_DEFAULT_TIMEOUT_MS": "300000"
  },
  "model": "opus",
  "effortLevel": "medium",
  "theme": "auto",
  "tui": "fullscreen",
  "autoCompactWindow": 500000,
  "autoUpdatesChannel": "stable",
  "skipDangerousModePermissionPrompt": true,
  "agentPushNotifEnabled": true,
  "enableAllProjectMcpServers": false,

  "permissions": {
    "defaultMode": "auto",
    "additionalDirectories": [
      "/Users/namit/Developer/dotfiles"
    ],
    "allow": [
      "Read(*)",
      "Edit(*)",
      "Write(*)",
      "WebSearch",
      "WebFetch(*)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(just *)",
      "Bash(uv *)",
      "Bash(brew *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./**/.env)",
      "Edit(./**/.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(./**/*.pem)",
      "Read(./**/id_rsa*)",
      "Read(./**/id_ed25519*)",
      "Bash(sudo *)",
      "Bash(rm -rf /*)",
      "Bash(gh repo delete:*)",
      "Bash(gh secret:*)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(rmdir *)"
    ]
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify-on-question.sh",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/format-on-edit.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/lint-on-edit.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify-on-stop.sh",
            "async": true
          }
        ]
      }
    ]
  },

  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },

  "enabledPlugins": {
    "warp@claude-code-warp": true,
    "clangd-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": false,
    "code-review@claude-plugins-official": false,
    "pr-review-toolkit@claude-plugins-official": false
  },

  "extraKnownMarketplaces": {
    "claude-code-warp": {
      "source": { "source": "github", "repo": "warpdotdev/claude-code-warp" }
    },
    "research-assistant": {
      "source": { "source": "github", "repo": "namitdeb739/research-assistant" }
    }
  },

  "sandbox": {
    "enabled": true,
    "filesystem": {
      "allowRead": [
        "./.env.example",
        "./**/.env.example",
        "./.env.sample",
        "./**/.env.sample",
        "./.env.template",
        "./**/.env.template"
      ],
      "allowWrite": [
        "~/.cache",
        "~/.local/state",
        "~/.local/share",
        "~/.npm",
        "/opt/homebrew"
      ]
    },
    "credentials": {
      "files": [
        { "path": "~/.ssh", "mode": "deny" },
        { "path": "~/.aws", "mode": "deny" },
        { "path": "~/.gnupg", "mode": "deny" }
      ]
    },
    "excludedCommands": [],
    "network": {
      "allowMachLookup": ["com.apple.trustd.agent"]
    }
  }
}
