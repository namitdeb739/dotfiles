# SSH client config.
#
# Stowed from the dotfiles repo. Machine-specific hosts belong in
# ~/.ssh/config.local, which is included first (Include wins on first match,
# so local entries override anything here) and is never committed.
#
# NOTE: keys themselves are never in this repo — only this config.

Include ~/.ssh/config.local

Host *
    # Load keys from the macOS Keychain and add them back on first use, so the
    # passphrase is entered once per machine rather than once per session.
    UseKeychain yes
    AddKeysToAgent yes
    IdentityFile ~/.ssh/id_ed25519

    # Only offer the key named above. Without this, ssh offers every key in the
    # agent and can trip a server's MaxAuthTries before reaching the right one.
    IdentitiesOnly yes

    # Keep long-running sessions alive through NAT timeouts; give up after
    # ~3 minutes of no response rather than hanging indefinitely.
    ServerAliveInterval 60
    ServerAliveCountMax 3

    # Reuse a single connection for repeated sessions to the same host, which
    # makes rsync/scp loops and git-over-ssh noticeably faster.
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%r@%h-%p
    ControlPersist 10m

    # Fail fast rather than silently falling back to password auth.
    PubkeyAuthentication yes
    HashKnownHosts yes

Host github.com
    HostName github.com
    User git
    # Git operations authenticate over HTTPS via the gh credential helper
    # (see .gitconfig), so this entry only matters for ssh remotes.
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes

Host gitlab.com
    HostName gitlab.com
    User git
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
