# Fresh-machine only — NOT run by bootstrap.sh.
#
# Run explicitly on a new machine, before the apps exist:
#   brew bundle --file="$(git rev-parse --show-toplevel)/brew/Brewfile.fresh-machine"
#
# These are declared for reproducibility, but cannot be part of the default
# bundle: once installed, Microsoft AutoUpdate owns them, and `brew bundle`
# fails trying to install over a copy it does not manage — which made the
# Brew phase exit 1 on every bootstrap run on an already-provisioned machine.
# `brew upgrade` without --greedy leaves self-updating casks alone, which is
# what dotfiles-update relies on.

cask "microsoft-office"  # Word, Excel, PowerPoint, Outlook, OneNote
cask "microsoft-teams"   # Meetings
cask "onedrive"          # File sync

# Same story, different updater: installed by hand here and self-updating.
cask "zoom"              # Meetings
cask "nrf-connect"       # nRF Connect for Desktop

# Managed by Homebrew here, but kept out of the default bundle: SEGGER
# replaces the .pkg in place, so the cask checksum goes stale and the
# download fails, which would fail the whole Brew phase of bootstrap.
cask "segger-jlink"      # J-Link debug probe tools
