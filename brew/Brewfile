# Dotfiles Brewfile — run: brew bundle --file="$(git rev-parse --show-toplevel)/brew/Brewfile"

# --- Shell ---
brew "stow"              # Symlink farm manager (dotfiles)
brew "starship"          # Cross-shell prompt
brew "antidote"          # Zsh plugin manager
brew "zoxide"            # Smart cd with frecency
brew "atuin"             # Shell history search (SQLite-backed)
brew "gum"               # Interactive terminal UI (used by bootstrap)

# --- Core CLI ---
brew "git"               # Version control
brew "gh"                # GitHub CLI
brew "lazygit"           # Git TUI — stage hunks, interactive rebase
brew "act"               # Run GitHub Actions locally in Docker
brew "tmux"              # Terminal multiplexer — Ghostty has no session persistence
brew "git-delta"         # Better git diffs (used as core.pager)
brew "fzf"               # Fuzzy finder
brew "fd"                # Better find
brew "ripgrep"           # Better grep
brew "bat"               # Better cat
brew "ast-grep"          # Structural code search/rewrite — safer than sed for edits
brew "difftastic"        # Structural diff — semantic review, ignores reformat noise
brew "typos-cli"         # Low-false-positive spellcheck for prose and code
brew "eza"               # Better ls (maintained exa fork)
brew "jq"                # JSON processor
brew "yq"                # YAML/TOML processor — the jq counterpart CLAUDE.md assumes
brew "tree"              # Directory tree viewer
brew "btop"              # Resource monitor — supersedes htop, themed to Catppuccin
brew "tlrc"              # Simplified man pages (official tldr client; replaces disabled tldr)
brew "direnv"            # Per-directory env vars
brew "shellcheck"        # Shell script static analysis
brew "gitleaks"          # Secret scanning (also a pre-commit hook; this makes it usable ad-hoc)
brew "osv-scanner"       # Dependency CVEs across every lockfile format (pip-audit is Python-only)
brew "lizard-analyzer"   # Cyclomatic complexity per function, ~15 languages — `lizard -C 15`
brew "scc"               # LOC, per-file complexity, language mix — repo shape at a glance
brew "neovim"            # Terminal editor
brew "tree-sitter-cli"   # Parser compiler required by nvim-treesitter (main branch)

# --- Documents ---
brew "tectonic"          # Self-contained TeX/LaTeX engine
brew "latexdiff"         # Marked-up thesis revisions for supervisor review
brew "poppler"           # PDF rendering and CLI tools (pdftotext, pdfimages)

# --- Media ---
brew "yt-dlp"            # Audio/video downloader

# --- AI ---
brew "ollama"            # Run LLMs locally

# --- Embedded ---
brew "picocom"           # Minimal serial terminal emulator
brew "clang-format"       # C/C++ formatter — used by the PostToolUse hook
brew "mspdebug"          # Debugger for TI MSP430 microcontrollers

# --- Python ---
brew "uv"                # Fast Python package manager
brew "ruff"              # Python linter/formatter
brew "bandit"            # Python security linter — required by the uv-python-quality skill
brew "pip-audit"         # Python dependency CVE audit — required by the uv-python-quality skill
brew "semgrep"           # Multi-language static analysis — required by the uv-python-quality skill
brew "pyright"           # Python language server — required by the pyright-lsp plugin

# --- Node ---
brew "fnm"               # Fast Node Manager (replaces nvm)
brew "typescript-language-server" # TS/JS language server — required by the typescript-lsp plugin

# --- Build ---
brew "just"              # Command runner (better make)
brew "pre-commit"        # Git hooks framework

# --- Casks ---
cask "visual-studio-code"
cask "docker-desktop"    # Containers
cask "ghostty"           # Primary terminal — GPU-accelerated, config at ghostty/
cask "iterm2"            # Terminal alternative
cask "raycast"           # Spotlight replacement
cask "nightfall"         # Menu bar dark/light mode toggle
cask "firefox"           # Web browser
cask "karabiner-elements"  # Keyboard customiser
cask "sanesidebuttons"   # System-wide navigation with mouse side buttons
cask "uniflash"          # TI microcontroller flash tool

# NOT declared here, deliberately: Hush and AdGuard Mini are Mac App Store
# apps. Homebrew cannot manage a MAS install — adopting one would replace the
# App Store copy and break its receipt and Safari extension registration. The
# `adguard` cask is a different product anyway (the standalone blocker, not
# AdGuard Mini). Reinstall either from the App Store.

# --- Apps (previously installed by hand, undeclared) ---
cask "loop"              # Window manager (radial snap menu)
cask "obsidian"          # Notes / knowledge base
cask "notion"            # Notes / databases — see notion-automations
cask "google-chrome"     # Browser
cask "telegram"          # Messaging
cask "whatsapp"          # Messaging
cask "iina"              # Video player
# Installed copy (1.0.19) is newer than the cask (1.0), so it is declared for
# a fresh machine but deliberately not adopted here — adopting would downgrade.
cask "cleanmymac"        # Disk cleanup

# The Microsoft apps live in brew/Brewfile.fresh-machine, not here. Homebrew
# cannot install over an existing Microsoft AutoUpdate install, so declaring
# them in this file made `brew bundle` exit 1 on every bootstrap run.

# --- Fonts ---
cask "font-jetbrains-mono-nerd-font"
cask "font-fira-code-nerd-font"
